# Template file for 'geant4'
pkgname=geant4
version=11.4.3
revision=1
build_style=cmake
configure_args="-D CMAKE_INSTALL_PREFIX=/usr
 -D BUILD_STATIC_LIBS=ON
 -D GEANT4_USE_G3TOG4=ON
 -D GEANT4_USE_GDML=ON
 -D GEANT4_USE_INVENTOR_QT=OFF
 -D GEANT4_USE_OPENGL_X11=ON
 -D GEANT4_USE_QT=ON
 -D GEANT4_USE_RAYTRACER_X11=ON
 -D GEANT4_USE_SYSTEM_CLHEP=ON
 -D GEANT4_USE_SYSTEM_ZLIB=ON
 -D GEANT4_USE_XM=ON
 -D GEANT4_INSTALL_PACKAGE_CACHE=OFF"
hostmakedepends="cmake"
makedepends="clhep-devel expat-devel libxerces-c-devel qt6-base-devel
 glu-devel motif-devel zlib-devel python3 boost-devel-minimal libXmu-devel"
depends="bash python3"
short_desc="Simulation toolkit for particle physics interactions"
maintainer="Artem Sabourov <vs.tema@gmail.com>"
license="Geant4 software license, g4/tools license"
homepage="http://geant4.cern.ch/"
distfiles="https://gitlab.cern.ch/${pkgname}/${pkgname}/-/archive/v${version}/${pkgname}-v${version}.tar.gz"
checksum=718752c1829cbfcf174f0e539d60ee3f76843b894444e61d2228d66a6887ef6e
restricted=yes
repository=nonfree

# geant4 depends on libCLHEP-2.4.7.1.so provided by clhep-2.4.7.1_1 package,
# but XBPS tools cannot map soname to a package automatically, and the build
# fails. To build geant4 package successfully, add the following mapping string
# in `common/shlibs`:
#
#     libCLHEP-2.4.7.1.so clhep-2.4.7.1_1
#

post_install() {
	# install licenses, clean extra copies
	vlicense LICENSE
	vlicense source/externals/g4tools/tools.license
	rm ${DESTDIR}/usr/share/Geant4/tools.license
	#
	# move documentation & examples to appropriate path
	vdoc README.rst
	vdoc CONTRIBUTING.rst
	vdoc CITATION.cff
	cp -r ReleaseNotes ${DESTDIR}/usr/share/doc/${pkgname}/ChangeLogs
	mv ${DESTDIR}/usr/share/Geant4/examples ${DESTDIR}/usr/share/doc/${pkgname}
	#
	# remove fonts licenses - they belong in -fonts package
	rm ${DESTDIR}/usr/share/Geant4/fonts/license_font_*.txt
	rm ${DESTDIR}/usr/share/Geant4/fonts/readme_font_lato.txt
	#
	# fix she-bangs in some python scripts in examples (we cannot resolve
	# packages-sonames, but somehow can detect obsolete sha-bangs in
	# the documentation of all places)
	grep -inr '#!/usr/bin/env python' ${DESTDIR}/usr/share/doc/${pkgname}/examples/ | \
		grep -v python3 | cut -d: -f1 | \
		while read PY; do
			sed -i 's/env python/env python3/' "${PY}"
		done
}

geant4-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove usr/lib/cmake
		vmove "usr/lib/*.a"
	}
}

geant4-doc_package() {
	short_desc+=" - documentation"
	pkg_install() {
		vmove usr/share/doc/${sourcepkg}/examples
	}
}

geant4-fonts_package() {
	license="SIL OPEN FONT LICENSE Version 1.1 - 26 February 2007, Apache-2.0"
	short_desc+=" - default fonts"
	pkg_install() {
		vlicense source/externals/g4tools/fonts/license_font_roboto.txt
		vlicense source/externals/g4tools/fonts/license_font_lato.txt
		vmove usr/share/Geant4/fonts
	}
}

geant4-all_package() {
	metapackage=yes
	depends="geant4>=${version} geant4-devel>=${version} geant4-fonts>=${version}
	 geant4data-abla>=3.3
	 geant4data-incl>=1.3
	 geant4data-radioactivedecay>=6.1.2
	 geant4data-channeling>=2.0
	 geant4data-ndl>=4.7.1
	 geant4data-realsurface>=2.2
	 geant4data-emlow>=8.8
	 geant4data-particlexs>=4.2
	 geant4data-saiddata>=2.0
	 geant4data-ensdfstate>=3.0
	 geant4data-photonevaporation>=6.1.2
	 geant4data-pii>=1.3"
	short_desc+=" - complete set"
	license="Public Domain"
}
