# Template file for 'libclhep'
pkgname=libclhep
version=2.4.7.1
revision=1
build_style=cmake
hostmakedepends="cmake texlive-core doxygen"
depends="bash"
short_desc="Class library for high energy physics"
maintainer="Artem Sabourov <vs.tema@gmail.com>"
license="GPL-3.0-or-later AND LGPL-3.0-or-later"
homepage="http://proj-clhep.web.cern.ch/"
distfiles="http://proj-clhep.web.cern.ch/proj-clhep/dist1/clhep-${version}.tgz"
wrksrc="${version}"
checksum=1c8304a7772ac6b99195f1300378c6e3ddf4ad07c85d64a04505652abb8a55f9

do_configure() {
	mkdir -p build
	cmake -S CLHEP -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCLHEP_BUILD_DOCS=ON
}

do_build() {
	cmake --build build --target all
}

do_check() {
	ctest --test-dir build
}

do_install() {
	DESTDIR=${DESTDIR} cmake --build build --target install
}

post_install() {
	mv ${DESTDIR}/usr/share/doc/CLHEP ${DESTDIR}/usr/share/doc/libclhep
	mv ${DESTDIR}/usr/share/doc/libclhep/Doxygen/html ${DESTDIR}/usr/share/doc/libclhep/html
	rm -r ${DESTDIR}/usr/share/doc/libclhep/Doxygen
}

libclhep-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove usr/lib/CLHEP-${version}
		vmove "usr/lib/*.a"
	}
}

libclhep-doc_package() {
	short_desc+=" - documentation"
	pkg_install() {
		vmove usr/share
	}
}

clhep_package() {
	metapackage=yes
	depends="libclhep>=${version} libclhep-devel>=${version}"
	short_desc=" - runtime and development packages"
	license="Public Domain"
}
